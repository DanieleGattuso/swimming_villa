# ─────────────────────────────────────────────────────────────
# The Swimming Villa — environment variables
# Copy to `.env.local` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public base URL (used to build Stripe success/cancel redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — get keys from https://dashboard.stripe.com/apikeys (use test keys)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Stripe webhook signing secret.
# Local dev: run `npm run stripe:listen` and copy the whsec_... it prints.
# Production: create an endpoint in the Stripe dashboard and copy its secret.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Currency + deposit policy
NEXT_PUBLIC_CURRENCY=eur
DEPOSIT_PERCENT=30
